# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Get this from https://cloud.mongodb.com -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lavan_portfolio?retryWrites=true&w=majority

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@lavan.dev
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# JWT Secret Key for Admin Sessions
JWT_SECRET=replace_with_a_long_random_secret_key_for_jwt_signing

# Allowed Frontend Origin (for CORS)
CLIENT_URL=http://localhost:3000
